# Environment Variables Configuration
# Copy this file to .env.local for local development

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_USE_MOCKS="true" # Set to "false" to connect to real backend API endpoints
NEXT_PUBLIC_API_BASE_URL="" # Leave empty for Next.js internal API routes, or set to your external API domain (e.g. https://api.mello.app)

# -----------------------------------------------------------------------------
# DATABASE & STORAGE (PostgreSQL / Supabase / Neon / PlanetScale)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/mello_db?schema=public"

# -----------------------------------------------------------------------------
# EMAIL & CRM SERVICE (Optional: Resend / Loops / SendGrid)
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="waitlist@mello.app"
LOOPS_API_KEY=""

# -----------------------------------------------------------------------------
# NOTIFICATION WEBHOOKS (Optional: Slack / Discord notifications on new signup)
# -----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""

# -----------------------------------------------------------------------------
# SECURITY & RATE LIMITING (Optional: Upstash Redis)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
ADMIN_API_KEY="mello_secret_admin_key_for_internal_metrics"
